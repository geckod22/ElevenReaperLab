  "notes": [
    "Local capability catalog, not proof of account access or an exhaustive ElevenLabs API schema.",
    "Suggested defaults are metadata only; they are never automatically merged into user settings.",
    "Use model-specific documentation over generic guidance where they disagree.",
    "REST speed limits use the official REST settings reference; the GUI range is kept separately.",
    "Model selection and worker payloads use this catalog; account availability remains unverified."
  ],
  "runtime_defaults": {
    "tts": "eleven_multilingual_v2",
    "sts": "eleven_multilingual_sts_v2",
    "stt": "scribe_v2"
  },
  "legacy_worker_parameters": {
    "tts": [
      "speed",
      "stability",
      "similarity_boost"
    ],
    "sts": [
      "speed",
      "stability",
      "similarity_boost"
    ],
    "stt": []
  },
  "parameters": {
    "speed": {
      "label": "Speed",
      "type": "number",
      "api_field": "speed",
      "destination": "voice_settings",
      "api_required": false,
      "minimum": 0.25,
      "maximum": 4,
      "suggested_default": 1,
      "description": "Speech rate multiplier.",
      "ui": {
        "control": "slider",
        "step": 0.01,
        "minimum": 0.5,
        "maximum": 2
      },
      "source_refs": [
        "rest_settings"
      ]
    },
    "stability": {
      "label": "Stability",
      "type": "number",
      "api_field": "stability",
      "destination": "voice_settings",
      "api_required": false,
      "minimum": 0,
      "maximum": 1,
      "suggested_default": 0.5,
      "description": "Balance between variation and consistent delivery.",
      "ui": {
        "control": "slider",
        "step": 0.01
      },
      "source_refs": [
        "voice_settings"
      ]
    },
    "similarity_boost": {
      "label": "Similarity",
      "type": "number",
      "api_field": "similarity_boost",
      "destination": "voice_settings",
      "api_required": false,
      "minimum": 0,
      "maximum": 1,
      "suggested_default": 0.75,
      "description": "Resemblance to the reference voice.",
      "ui": {
        "control": "slider",
        "step": 0.01
      },
      "source_refs": [
        "voice_settings"
      ]
    },
    "style": {
      "label": "Style",
      "type": "number",
      "api_field": "style",
      "destination": "voice_settings",
      "api_required": false,
      "minimum": 0,
      "maximum": 1,
      "suggested_default": 0,
      "description": "Emphasis on the reference voice's delivery.",
      "ui": {
        "control": "slider",
        "step": 0.01
      },
      "source_refs": [
        "rest_settings"
      ]
    },
    "use_speaker_boost": {
      "label": "Speaker boost",
      "type": "boolean",
      "api_field": "use_speaker_boost",
      "destination": "voice_settings",
      "api_required": false,
      "suggested_default": true,
      "description": "Additional processing for voice resemblance.",
      "ui": {
        "control": "checkbox"
      },
      "source_refs": [
        "voice_settings"
      ]
    },
    "seed": {
      "label": "Seed",
      "type": "integer",
      "api_field": "seed",
      "destination": "request",
      "api_required": false,
      "minimum": 0,
      "maximum": 4294967295,
      "suggested_default": 0,
      "description": "Best-effort reproducibility; no deterministic guarantee.",
      "ui": {
        "control": "integer"
      },
      "source_refs": [
        "tts",
        "sts"
      ]
    },
    "remove_background_noise": {
      "label": "Remove background noise",
      "type": "boolean",
      "api_field": "remove_background_noise",
      "destination": "request",
      "api_required": false,
      "suggested_default": false,
      "description": "Request input noise isolation.",
      "ui": {
        "control": "checkbox"
      },
      "source_refs": [
        "sts"
      ]
    },
    "language_code": {
      "label": "Language",
      "type": "string",
      "api_field": "language_code",
      "destination": "request",
      "api_required": false,
      "min_length": 2,
      "max_length": 3,
      "description": "ISO 639-1 or ISO 639-3 language code; omit for automatic detection.",
      "ui": {
        "control": "text"
      },
      "source_refs": [
        "stt"
      ]
    },
    "tag_audio_events": {
      "label": "Tag audio events",
      "type": "boolean",
      "api_field": "tag_audio_events",
      "destination": "request",
      "api_required": false,
      "suggested_default": true,
      "description": "Include non-speech audio event annotations.",
      "ui": {
        "control": "checkbox"
      },
      "source_refs": [
        "stt"
      ]
    },
    "diarize": {
      "label": "Identify speakers",
      "type": "boolean",
      "api_field": "diarize",
      "destination": "request",
      "api_required": false,
      "suggested_default": false,
      "description": "Annotate speaker changes in the transcript.",
      "ui": {
        "control": "checkbox"
      },
      "source_refs": [
        "stt"
      ]
    },
    "num_speakers": {
      "label": "Number of speakers",
      "type": "integer",
      "api_field": "num_speakers",
      "destination": "request",
      "api_required": false,
      "minimum": 1,
      "maximum": 32,
      "suggested_default": 2,
      "description": "Maximum expected speaker count.",
      "ui": {
        "control": "integer"
      },
      "source_refs": [
        "stt"
      ]
    },
    "timestamps_granularity": {
      "label": "Timestamp detail",
      "type": "string",
      "api_field": "timestamps_granularity",
      "destination": "request",
      "api_required": false,
      "enum": [
        "none",
        "word",
        "character"
      ],
      "suggested_default": "word",
      "description": "Transcript timing detail.",
      "ui": {
        "control": "select",
        "labels": [
          "None",
          "Words",
          "Characters"
        ]
      },
      "source_refs": [
        "stt"
      ]
    },
    "temperature": {
      "label": "Temperature",
      "type": "number",
      "api_field": "temperature",
      "destination": "request",
      "api_required": false,
      "minimum": 0,
      "maximum": 2,
      "suggested_default": 0,
      "description": "Transcription sampling variation.",
      "ui": {
        "control": "slider",
        "step": 0.01
      },
      "source_refs": [
        "stt"
      ]
    },
    "diarization_threshold": {
      "label": "Speaker separation threshold",
      "type": "number",
      "api_field": "diarization_threshold",
      "destination": "request",
      "api_required": false,
      "minimum": 0.1,
      "maximum": 0.4,
      "suggested_default": 0.22,
      "description": "Optional speaker separation sensitivity; requires diarization and no explicit speaker count.",
      "ui": {
        "control": "slider",
        "step": 0.01
      },
      "source_refs": [
        "stt"
      ]
    },
    "no_verbatim": {
      "label": "Remove filler words",
      "type": "boolean",
      "api_field": "no_verbatim",
      "destination": "request",
      "api_required": false,
      "suggested_default": false,
      "description": "Omit fillers, false starts and non-speech sounds; Scribe v2 only.",
      "ui": {
        "control": "checkbox"
      },
      "source_refs": [
        "stt"
      ]
    }
